    "descriptionModule": {
     "briefSummary": "This study tests whether extended-release metformin improves glycemic control over 24 weeks in adults with type 2 diabetes who are not reaching target HbA1c on diet alone.",
     "detailedDescription": "Participants are randomized 1:1 to metformin XR 1500 mg once daily or matching placebo for 24 weeks. The primary outcome is change in HbA1c from baseline to week 24."
    },
