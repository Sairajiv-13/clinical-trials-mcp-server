# ClinicalTrials.gov API v2 base URL. The default is the public API.
CT_MCP_BASE_URL=https://clinicaltrials.gov/api/v2

# Per-request timeout in seconds.
CT_MCP_TIMEOUT_SECONDS=15

# How long a successful GET response is cached, in seconds. 0 disables caching.
CT_MCP_CACHE_TTL_SECONDS=300

# Extra attempts after a failed request (5xx responses and network errors only).
CT_MCP_MAX_RETRIES=2
